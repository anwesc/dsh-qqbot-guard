{
  "name": "dsh-qqbot-guard",
  "version": "1.2.1",
  "type": "module",
  "description": "qqbot 增强层：群聊关键词放行 + 续聊窗口（批量汇总判定、逐条回复、刷屏保护只回相关、可选引用回复） + 历史上下文 + 设置页可视化配置（进程内补丁，不改 qqbot 文件）",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "selfcheck": "node selfcheck.mjs",
    "test": "node --test *.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "qqbot",
    "qq",
    "tencent-connect"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anwesc/dsh-qqbot-guard.git"
  },
  "homepage": "https://github.com/anwesc/dsh-qqbot-guard#readme",
  "bugs": {
    "url": "https://github.com/anwesc/dsh-qqbot-guard/issues"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@tencent-connect/dsh-qqbot": ">=0.5.3"
  },
  "peerDependenciesMeta": {
    "@tencent-connect/dsh-qqbot": {
      "optional": true
    }
  }
}
